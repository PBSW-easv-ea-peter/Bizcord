{
    "Routes": [
        {
            "Key": "chats-create",
            "UpstreamPathTemplate": "/chats/{type}",
            "UpstreamHttpMethod": ["POST"],
            "DownstreamPathTemplate": "/chats/{type}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [{ "Host": "host.docker.internal", "Port": 8081 }],
            "DownstreamHeaderTransform": { "Location": "{DownstreamBaseUrl}, {BaseUrl}" }
        },
        {
            "Key": "chat",
            "UpstreamPathTemplate": "/chats/{chatId}/info",
            "UpstreamHttpMethod": ["GET"],
            "DownstreamPathTemplate": "/chats/{chatId}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [{ "Host": "host.docker.internal", "Port": 8081 }]
        },
        {
            "Key": "chat-participants",
            "UpstreamPathTemplate": "/chats/{chatId}/participants",
            "UpstreamHttpMethod": ["POST"],
            "DownstreamPathTemplate": "/chats/{chatId}/participants",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [{ "Host": "host.docker.internal", "Port": 8081 }]
        },
        {
            "Key": "messages",
            "UpstreamPathTemplate": "/chats/{chatId}/messages",
            "UpstreamHttpMethod": ["GET", "POST"],
            "DownstreamPathTemplate": "/chats/{chatId}/messages",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [{ "Host": "host.docker.internal", "Port": 8081 }]
        },
        {
            "Key": "chat-message-by-id",
            "UpstreamPathTemplate": "/chats/{chatId}/messages/{everything}",
            "UpstreamHttpMethod": ["GET", "POST", "PUT", "DELETE"],
            "DownstreamPathTemplate": "/chats/{chatId}/messages/{everything}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [{ "Host": "host.docker.internal", "Port": 8081 }]
        }
    ],
    "Aggregates": [
        {
            "UpstreamPathTemplate": "/chats/{chatId}",
            "RouteKeys": ["chat", "messages"]
        }
    ]
}