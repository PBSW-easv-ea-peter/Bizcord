# Copy to .env (git-ignored): cp .env.example .env - see "Kør projektet" in README.md.

# App token for the API gateway. A fixed, made-up id for this school project: README step 3
# creates a Vault token with exactly this id and the secrets-reader policy.
VAULT_TOKEN=bizcord-gateway-dev-token

# App token for ChatService (East/West: it validates the gateway's JWT itself and reads the signing key
# from Vault). Own token with the same secrets-reader policy, so it can be revoked without the gateway.
CHATSERVICE_VAULT_TOKEN=bizcord-chatservice-dev-token
