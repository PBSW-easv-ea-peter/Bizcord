{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Vault": {
    "Address": "http://vault:8200"
  },
  "Jwt": {
    "Issuer": "http://api-gateway",
    "Audience": "internal-api",
    "ExpiryHours": 5
  }
}
