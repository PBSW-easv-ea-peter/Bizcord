{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Vault": {
    "Address": "http://vault:8200"
  },
  "Jwt": {
    "Issuer": "http://api-gateway",
    "Audience": "internal-api",
    "ExpiryHours": 5
  },
  "DownstreamQoS": {
    "Timeout": "00:00:02",
    "FailureRatio": 0.5,
    "MinimumThroughput": 3,
    "SamplingDuration": "00:00:10",
    "BreakDuration": "00:00:05"
  }
}
