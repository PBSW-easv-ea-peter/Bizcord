{
  "Routes": [
    {
      "Key": "swagger-ui",
      "UpstreamPathTemplate": "/chat-swagger/{everything}",
      "UpstreamHttpMethod": ["GET"],
      "DownstreamPathTemplate": "/swagger/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "chatservice", "Port": 8081 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [], "AllowedScopes": [] },
      "RouteClaimsRequirement": {}
    },
    {
      "Key": "openapi-spec",
      "UpstreamPathTemplate": "/chat-openapi/{everything}",
      "UpstreamHttpMethod": ["GET"],
      "DownstreamPathTemplate": "/openapi/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "chatservice", "Port": 8081 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [], "AllowedScopes": [] },
      "RouteClaimsRequirement": {}
    },
    {
      "Key": "chats-create",
      "UpstreamPathTemplate": "/chats/{type}",
      "UpstreamHttpMethod": ["POST"],
      "DownstreamPathTemplate": "/chats/{type}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "chatservice", "Port": 8081 }],
      "DownstreamHeaderTransform": { "Location": "{DownstreamBaseUrl}, {BaseUrl}" },
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"], "AllowedScopes": [] },
      "RouteClaimsRequirement": { "role": "member" },
      "AddHeadersToRequest": { "X-User-Id": "Claims[sub] > value" }
    },
    {
      "Key": "chat",
      "UpstreamPathTemplate": "/chats/{chatId}",
      "UpstreamHttpMethod": ["GET"],
      "DownstreamPathTemplate": "/chats/{chatId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "chatservice", "Port": 8081 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"], "AllowedScopes": [] },
      "RouteClaimsRequirement": { "role": "member" },
      "AddHeadersToRequest": { "X-User-Id": "Claims[sub] > value" }
    },
    {
      "Key": "chat-participants",
      "UpstreamPathTemplate": "/chats/{chatId}/participants",
      "UpstreamHttpMethod": ["POST"],
      "DownstreamPathTemplate": "/chats/{chatId}/participants",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "chatservice", "Port": 8081 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"], "AllowedScopes": [] },
      "RouteClaimsRequirement": { "role": "member" },
      "AddHeadersToRequest": { "X-User-Id": "Claims[sub] > value" }
    },
    {
      "Key": "messages",
      "UpstreamPathTemplate": "/chats/{chatId}/messages",
      "UpstreamHttpMethod": ["GET", "POST"],
      "DownstreamPathTemplate": "/chats/{chatId}/messages",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "chatservice", "Port": 8081 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"], "AllowedScopes": [] },
      "RouteClaimsRequirement": { "role": "member" },
      "AddHeadersToRequest": { "X-User-Id": "Claims[sub] > value" }
    },
    {
      "Key": "chat-message-by-id",
      "UpstreamPathTemplate": "/chats/{chatId}/messages/{messageId}",
      "UpstreamHttpMethod": ["PUT", "DELETE"],
      "DownstreamPathTemplate": "/chats/{chatId}/messages/{messageId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "chatservice", "Port": 8081 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"], "AllowedScopes": [] },
      "RouteClaimsRequirement": { "role": "member" },
      "AddHeadersToRequest": { "X-User-Id": "Claims[sub] > value" }
    },
    {
      "Key": "message-seen",
      "UpstreamPathTemplate": "/chats/{chatId}/messages/{messageId}/seen",
      "UpstreamHttpMethod": ["POST"],
      "DownstreamPathTemplate": "/chats/{chatId}/messages/{messageId}/seen",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "chatservice", "Port": 8081 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"], "AllowedScopes": [] },
      "RouteClaimsRequirement": { "role": "member" },
      "AddHeadersToRequest": { "X-User-Id": "Claims[sub] > value" }
    },
    {
      "Key": "message-receipts",
      "UpstreamPathTemplate": "/chats/{chatId}/messages/{messageId}/receipts",
      "UpstreamHttpMethod": ["GET"],
      "DownstreamPathTemplate": "/chats/{chatId}/messages/{messageId}/receipts",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "chatservice", "Port": 8081 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"], "AllowedScopes": [] },
      "RouteClaimsRequirement": { "role": "member" },
      "AddHeadersToRequest": { "X-User-Id": "Claims[sub] > value" }
    }
  ],
  "Aggregates": [
    {
      "UpstreamPathTemplate": "/chats/{chatId}/overview",
      "RouteKeys": ["chat", "messages"]
    }
  ]
}
