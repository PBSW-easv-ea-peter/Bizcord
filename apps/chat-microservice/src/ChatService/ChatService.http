### ChatService - manual testing (run the service with: dotnet run --project src/ChatService)
@host = http://localhost:5031
@alice = 11111111-1111-1111-1111-111111111111
@bob = 22222222-2222-2222-2222-222222222222

### Create group (Alice becomes Owner)
# @name createGroup
POST {{host}}/chats/group
X-User-Id: {{alice}}
Content-Type: application/json

{ "title": "Team" }

###
@chatId = {{createGroup.response.body.$.id}}

### Add Bob
POST {{host}}/chats/{{chatId}}/participants
X-User-Id: {{alice}}
Content-Type: application/json

{ "userId": "{{bob}}" }

### Bob sends a message
# @name send
POST {{host}}/chats/{{chatId}}/messages
X-User-Id: {{bob}}
Content-Type: application/json

{ "content": "Hej Alice" }

###
@messageId = {{send.response.body.$.id}}

### Alice fetches messages (newest first)
GET {{host}}/chats/{{chatId}}/messages?limit=20
X-User-Id: {{alice}}

### Bob edits the message
PUT {{host}}/chats/{{chatId}}/messages/{{messageId}}
X-User-Id: {{bob}}
Content-Type: application/json

{ "content": "Hej Alice!" }

### Alice marks up to and including the message as seen
POST {{host}}/chats/{{chatId}}/messages/{{messageId}}/seen
X-User-Id: {{alice}}

### Bob ser receipts
GET {{host}}/chats/{{chatId}}/messages/{{messageId}}/receipts
X-User-Id: {{bob}}

### Bob deletes the message (soft delete, idempotent - 204 every time)
DELETE {{host}}/chats/{{chatId}}/messages/{{messageId}}
X-User-Id: {{bob}}

### Direct chat (idempotent: 201 the first time, then 200)
POST {{host}}/chats/direct
X-User-Id: {{alice}}
Content-Type: application/json

{ "otherUserId": "{{bob}}" }
