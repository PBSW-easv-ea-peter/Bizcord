{
  "Logging": {
    "ServiceName": "ChatService",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "PublishTimeout": "00:00:02"
  },
  "Jwt": {
    "Issuer": "http://api-gateway",
    "Audience": "internal-api"
  },
  "Vault": {
    "Address": "http://vault:8200"
  },
  "AllowedHosts": "*"
}
